    "notes": { ".read": true, ".write": true },
    "lockdown": { ".read": true, ".write": true },
    "schedules": { ".read": true, ".write": true },
    "autoshot": { ".read": true, ".write": true },
    "global_block": { ".read": true, ".write": true },
    "mods": { ".read": true, ".write": true },
    "admins": { ".read": true, ".write": true },
    "settings": { ".read": true, ".write": true }
  }
